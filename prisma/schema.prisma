// Hidden Nepal data model.
// Docs: https://pris.ly/d/prisma-schema
// Design notes and planned models: docs/data-model.md
//
// Some invariants are enforced with CHECK constraints added by hand in
// migrations (Prisma cannot express them): slug format, coordinate and cost
// ranges, lowercase email. See prisma/migrations/*_catalog_relations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

/// Never accepted from the browser. New accounts are always USER; ADMIN is
/// granted only by `npm run admin:grant` or by another admin.
enum UserRole {
  USER
  /// Reserved for the editorial workflow; no extra permissions yet.
  EDITOR
  ADMIN
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MODERATE
  CHALLENGING
  STRENUOUS
}

/// ISO 4217 codes the platform prices in.
enum Currency {
  NPR
  USD
}

/// Nepal's four broad travel seasons.
enum Season {
  SPRING // roughly March–May
  MONSOON // roughly June–August
  AUTUMN // roughly September–November
  WINTER // roughly December–February
}

/// How trustworthy a destination's practical details are (cost, coordinates,
/// elevation, difficulty, seasons, suggested days). Only VERIFIED details may
/// be presented to travellers as advice.
enum InfoStatus {
  PLACEHOLDER // invented for development; never show as fact
  UNVERIFIED // sourced but not yet checked
  VERIFIED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

// ─── Identity ───────────────────────────────────────────────────────────────

/// Core user record. Field names follow Auth.js conventions so its adapter
/// tables (Account, Session, VerificationToken) can be added without changes.
model User {
  id             String    @id @default(cuid())
  /// Stored lowercase (CHECK constraint) so uniqueness is case-insensitive.
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  image          String?
  role           UserRole  @default(USER)
  /// scrypt hash (src/features/auth/password.ts). Null for accounts that
  /// cannot sign in with a password. Never selected outside the auth module.
  passwordHash   String?
  /// Embedded in every session token; incrementing it revokes all sessions.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  placeSubmissions  PlaceSubmission[]
  savedDestinations SavedDestination[]
}

/// A user's favourite destination. The composite key prevents duplicates.
model SavedDestination {
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String
  createdAt     DateTime    @default(now())

  @@id([userId, destinationId])
  // Profile: a user's saves, newest first.
  @@index([userId, createdAt(sort: Desc)])
  @@index([destinationId])
}

/// Fixed-window counters for rate-limited endpoints (sign-in, registration).
/// Keys are SHA-256 hashes, so no email or IP address is stored.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

/// Nepal's seven provinces. Seeded from src/features/regions/provinces.ts.
model Region {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  sortOrder    Int               @default(0)
  destinations Destination[]
  submissions  PlaceSubmission[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

/// Experience categories. Seeded from src/features/experiences/categories.ts,
/// which remains the source of truth for slugs used in URLs.
model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  name         String
  description  String
  sortOrder    Int                   @default(0)
  destinations DestinationCategory[]
  submissions  PlaceSubmission[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model Destination {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  summary     String
  description String?
  status      PublishStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  /// Editorially chosen lesser-known place for the homepage "Off the map" section.
  isHiddenGem Boolean       @default(false)
  /// Development sample content created by the seed script.
  isSample    Boolean       @default(false)

  /// Province. Restrict: a province with destinations cannot be deleted.
  region   Region  @relation(fields: [regionId], references: [id], onDelete: Restrict)
  regionId String
  district String?

  // Practical details. Trust level is recorded in practicalInfoStatus.
  latitude         Decimal?    @db.Decimal(9, 6)
  longitude        Decimal?    @db.Decimal(9, 6)
  elevationM       Int?
  /// Whole currency units per person for a typical visit.
  estimatedCostMin Int?
  estimatedCostMax Int?
  currency         Currency    @default(NPR)
  costNotes        String?
  difficulty       Difficulty?
  suggestedDays    Int?
  bestSeasonNotes  String?
  /// How to get there: transport, road/trail access, permits. VERIFIED only.
  accessInfo       String?
  /// Safety and preparation: altitude, weather hazards, what to carry. VERIFIED only.
  safetyInfo       String?

  practicalInfoStatus     InfoStatus @default(UNVERIFIED)
  practicalInfoVerifiedAt DateTime?

  categories DestinationCategory[]
  images     DestinationImage[]
  seasons    DestinationSeason[]
  activities DestinationActivity[]
  sources    DestinationSource[]
  savedBy    SavedDestination[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Homepage: published + featured, newest first.
  @@index([status, isFeatured, publishedAt(sort: Desc)])
  // Homepage: published hidden gems.
  @@index([status, isHiddenGem, publishedAt(sort: Desc)])
  // Explore: filter by province among published.
  @@index([regionId, status])
  @@index([difficulty])
  // Explore: alphabetical sort among published.
  @@index([status, name])
  // Explore: district filter within a province.
  @@index([regionId, district])
  // Explore: practical filters (difficulty, budget, season) need VERIFIED rows.
  @@index([status, practicalInfoStatus, estimatedCostMin])
}

/// Many-to-many destination ↔ category. The lowest `position` is the
/// destination's primary category.
model DestinationCategory {
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String
  /// Restrict: retire a category by reassigning its destinations first.
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId    String
  position      Int         @default(0)

  @@id([destinationId, categoryId])
  // Explore: filter by category.
  @@index([categoryId])
}

/// Ordered gallery; position 0 is the cover. Attribution travels with the image.
model DestinationImage {
  id            String      @id @default(cuid())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String
  url           String
  alt           String
  caption       String?
  credit        String?
  license       String?
  sourceUrl     String?
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([destinationId, position])
}

/// Things to do. Seeded from src/features/destinations/activities.ts.
model Activity {
  id           String                @id @default(cuid())
  slug         String                @unique
  name         String
  sortOrder    Int                   @default(0)
  destinations DestinationActivity[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

/// Activities available at a destination. Shown only when practical info is
/// VERIFIED, since availability changes with season and local conditions.
model DestinationActivity {
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String
  activity      Activity    @relation(fields: [activityId], references: [id], onDelete: Restrict)
  activityId    String
  position      Int         @default(0)

  @@id([destinationId, activityId])
  @@index([activityId])
}

/// Where the published facts come from. Shown on the detail page.
model DestinationSource {
  id            String      @id @default(cuid())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String
  title         String
  url           String
  publisher     String?
  accessedAt    DateTime?
  position      Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([destinationId, url])
  @@index([destinationId, position])
}

model DestinationSeason {
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String
  season        Season

  @@id([destinationId, season])
  @@index([season])
}

// ─── Community ──────────────────────────────────────────────────────────────

/// A place suggested by a visitor. Nothing is published from here directly:
/// an editor researches it and, if suitable, creates a Destination.
model PlaceSubmission {
  id              String           @id @default(cuid())
  placeName       String
  /// SetNull: deleting a province/category must not erase suggestions.
  region          Region?          @relation(fields: [regionId], references: [id], onDelete: SetNull)
  regionId        String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      String?
  locationDetails String?
  description     String
  submitterName   String?
  /// Optional, lowercase; used only to follow up on this suggestion.
  submitterEmail  String?
  /// Set once accounts exist. SetNull keeps the suggestion if a user is deleted.
  submitter       User?            @relation(fields: [submitterId], references: [id], onDelete: SetNull)
  submitterId     String?
  /// The submitter confirmed the content is theirs to share.
  consentToShare  Boolean
  status          SubmissionStatus @default(PENDING)
  reviewNotes     String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Moderation queue: oldest pending first.
  @@index([status, createdAt])
}
