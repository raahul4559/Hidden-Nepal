# Copy to .env (`cp .env.example .env`) and fill in values. Never commit .env.
# None of these are exposed to the browser: there are no NEXT_PUBLIC_ variables.

# PostgreSQL connection string used by Prisma (app runtime, migrations, seed).
# Optional for UI work: without it, destination sections show empty states.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hidden_nepal"

# Optional. Database for `npm run test:integration`. Its name MUST end in
# _test: the suite migrates it and truncates its tables.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hidden_nepal_test"

# Seed sample destinations (development placeholders). Defaults to true;
# always refused when NODE_ENV=production.
# SEED_SAMPLE_DATA="false"

# Seed source-attributed destinations from data/nepal-tourism-destinations.json.
# Defaults to true; records needing review are imported as drafts.
# SEED_RESEARCHED_DATA="false"

# Import editor-supplied Instagram references and places from
# data/instagram-references.json during db:seed. Defaults to true.
# SEED_INSTAGRAM_DATA="false"

# Optional Instagram collection. Without these, `npm run data:instagram` only
# imports manually supplied post URLs from data/instagram-references.json.
# The Graph API requires a professional account, a linked Facebook Page and the
# instagram_basic permission. No scraping is supported.
# INSTAGRAM_ACCESS_TOKEN=""
# INSTAGRAM_USER_ID=""
# INSTAGRAM_API_VERSION="v23.0"
# Attach authorized account media to one destination:
# INSTAGRAM_DESTINATION_SLUG="pokhara"
# Or map hashtags to destinations:
# INSTAGRAM_HASHTAGS="everest:mount-everest,pokhara:pokhara"
# INSTAGRAM_MAX_PAGES="5"

# Required for sign-in. Encrypts session cookies; at least 32 characters.
# Generate with `npx auth secret` or `openssl rand -base64 33`. Changing it
# signs everyone out.
AUTH_SECRET=""

# Production only, when not on Vercel: the public origin, so Auth.js builds
# callback URLs from it instead of trusting the Host header.
# AUTH_URL="https://hiddennepal.example"
# Or, behind a proxy that sets Host/X-Forwarded-Host correctly:
# AUTH_TRUST_HOST="true"

# Public origin for canonical URLs, Open Graph and the sitemap.
# Optional: falls back to the Vercel production domain, the Hidden Nepal
# production domain on other production hosts, then localhost in development.
# SITE_URL="https://hiddennepal-one.vercel.app"
